# WA app runtime
# Override these values before running: cp .env.example .env

# Release image tag (build locally or pull from ghcr.io/gnsvip/wa-app-service)
WA_APP_IMAGE_TAG=v1.1.0

# Optional dashboard login. Leave empty to disable.
WA_APP_AUTH_PASSWORD=

# Persistent data directory inside container.
WA_APP_DATA_DIR=/var/lib/wa-app

# Optional persistence backends (defaults to embedded sqlite/runtime state if empty)
WA_APP_PG_DSN=
WA_APP_REDIS_URL=

# Optional shared WA outbound proxy (leave empty for direct outbound)
WA_COMMON_PROXY=

# Optional device-profile pool file (leave empty to use the built-in models)
WA_APP_DEVICE_PROFILES_FILE=

# Optional SMS-Code-Receiver gateway used by WA registration auto-number/auto-OTP.
# Keep this token long and random. It must match SMS-Code-Receiver/config.json gateway.apiToken.
WA_APP_SMS_GATEWAY_URL=http://sms-code-receiver:9010
WA_APP_SMS_GATEWAY_TOKEN=
